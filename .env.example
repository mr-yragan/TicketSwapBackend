# Copy to .env for local bootstrap of the first admin account.
# Do not commit real production secrets.

TICKETSWAP_JWT_SECRET=replace-with-at-least-32-random-characters
TICKETSWAP_PARTNER_API_INTERNAL_TOKEN=replace-with-random-partner-internal-token
TICKETSWAP_PAYMENT_API_INTERNAL_TOKEN=replace-with-random-payment-internal-token

# Optional first admin bootstrap. Disabled by default.
TICKETSWAP_BOOTSTRAP_ADMIN_ENABLED=false
TICKETSWAP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
TICKETSWAP_BOOTSTRAP_ADMIN_LOGIN=admin
TICKETSWAP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password-12-plus-chars

SPRING_JPA_SHOW_SQL=false
